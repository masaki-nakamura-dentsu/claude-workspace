{
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "permissions": {
    "allow": [
      "Bash(python3 -P /Users/d14461/SalesforceExport/import_scripts/jci_import_wizard.py:*)",
      "Read(//Users/d14461/.claude/projects/*/memory/**)",
      "Edit(//Users/d14461/.claude/projects/*/memory/**)",
      "Read(//Users/maxakisan/.claude/projects/*/memory/**)",
      "Edit(//Users/maxakisan/.claude/projects/*/memory/**)",
      "Bash(git push -u origin main:*)",
      "Bash(python3 *)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff 2>/dev/null || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff 2>/dev/null || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/context_warn.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/statusline_tokens.py",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "context7@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "/Users/d14461/.claude/projects/*/memory/**",
        "/Users/maxakisan/.claude/projects/*/memory/**"
      ]
    },
    "allowAppleEvents": true
  },
  "effortLevel": "low",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "theme": "dark",
  "remoteControlAtStartup": true,
  "autoUploadSessions": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Monthly JCI pitch import into the dentsu Salesforce org (dgx.lightning.force.com / dgx.my.salesforce-setup.com) is a standing-approved recurring task: running /Users/d14461/SalesforceExport/import_scripts/jci_import_wizard.py (prepare, start, jobs, check) with CSVs generated by build_import_csv.py in the BD部集約_JPターンアラウンド folder is allowed. Claude reports the final confirmation screen to the user before running start."
    ]
  }
}
